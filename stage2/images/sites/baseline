{
	# Email for Let's Encrypt notifications (certificate expiration, etc.)
	email anduin@aiursoft.com
	
	log {
		format json
		output file /data/caddy/logs/web.log {
			roll_size 1gb
			# Five archives plus the active file cover at most 24 hours with UTC rotation.
			roll_at 00:00 04:00 08:00 12:00 16:00 20:00
			roll_keep 5
			roll_keep_for 24h
			roll_uncompressed
		}
		level info
	}
	servers :443 {
		listener_wrappers {
			http_redirect
			tls
		}
	}
}

(hsts) {
	header Strict-Transport-Security max-age=63072000
}
